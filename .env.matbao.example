# ALPHA DESIGN ERP Cloud v4.5.32 — Mắt Bão / Supabase
# Sao chép thành .env.production.local trong Application Root (KHÔNG đặt trong public/).
# Phân quyền file trên Linux: chmod 600 .env.production.local

ALPHA_ENV=production
NODE_ENV=production
DATA_MODE=server-authoritative

# Supabase — URL và Publishable/Anon key có thể xuất hiện ở trình duyệt khi RLS đã bật.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SB_PUBLISHABLE_KEY
# Legacy fallback: SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# BÍ MẬT PHÍA SERVER — không đưa vào Git, public/, ảnh chụp hoặc trình duyệt.
SUPABASE_SECRET_KEY=YOUR_SB_SECRET_KEY_SERVER_ONLY
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY
VALIDATION_EVIDENCE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Chỉ cho phép đúng các URL HTTPS của ALPHA DESIGN ERP.
CORS_ORIGINS=https://erp.alphadesign.vn,https://staging-erp.alphadesign.vn

# Nhận diện công ty trong runtime.
ALPHA_COMPANY_ID=00000000-0000-0000-0000-000000000000
ALPHA_COMPANY_CODE=ALPHA
ALPHA_COMPANY_NAME="ALPHA DESIGN CO., LTD"
ALPHA_OWNER_NAME="Giám đốc ALPHA DESIGN"

# Bảo mật và đồng bộ.
REQUIRE_AUTH_IN_STAGING=true
ALLOW_CLIENT_DB=false
TRUST_PROXY=true
TRUST_PROXY_HOPS=1
SYNC_INTERVAL_MS=10000
SUPABASE_TIMEOUT_MS=15000
RATE_LIMIT_PER_MINUTE=180
MAX_BODY_BYTES=2097152
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000

# Mắt Bão/cPanel thường tự cấp PORT. Chỉ đặt PORT nếu control panel yêu cầu.
HOST=0.0.0.0
# PORT=8787
