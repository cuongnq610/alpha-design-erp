ALPHA_ENV=production
NODE_ENV=production
DATA_MODE=server-authoritative
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SB_PUBLISHABLE_KEY
# Legacy fallback: SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
CORS_ORIGINS=https://erp.alphadesign.vn,https://staging-erp.alphadesign.vn
RATE_LIMIT_PER_MINUTE=180
MAX_BODY_BYTES=2097152
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
HOST=0.0.0.0
PORT=8787
# Never expose SUPABASE_SECRET_KEY or legacy SUPABASE_SERVICE_ROLE_KEY to the browser.

# Production validation pipeline (server/CI only)
ALPHA_COMPANY_ID=00000000-0000-0000-0000-000000000000
VALIDATION_EVIDENCE_SECRET=replace-with-32-plus-random-characters
SUPABASE_SECRET_KEY=sb_secret_server-only-never-expose-in-browser
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=legacy-server-only-never-expose-in-browser
